# Copy to .env and fill in. NEVER commit .env.  `.gitignore` already blocks it.
# Every provider below speaks the OpenAI chat-completions protocol, so there is
# exactly one adapter in app/interpretation/provider.py and zero provider-specific code.
#
# IMPORTANT: every value below is a bare KEY=VALUE with no trailing comment.
# `docker run --env-file` and Azure Container Apps both set these as literal OS
# environment variables and do NOT strip a trailing "# ..." the way
# pydantic-settings' own .env parser does -- a value like "5   # some note"
# fails int()/float() parsing the moment it leaves this repo's local dev
# environment. Keep every explanatory comment on its own line, above the
# variable it explains, exactly as this file already does.

# --- primary model (hosted; this is what the judge's traffic hits) -----------
# OpenAI      -> https://api.openai.com/v1
# Groq        -> https://api.groq.com/openai/v1
# Gemini      -> https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter  -> https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

# --- fallback model (Siyam's local Ollama, or a second hosted provider) ------
# Leave blank to disable. Must still be a language model: an empty fallback may
# NEVER be turned into "all notes are no_op".
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_API_KEY=ollama
LLM_FALLBACK_MODEL=qwen3:8b

# --- CLAMP knobs -------------------------------------------------------------
# K samples requested in ONE batched call. K=1 disables hedging.
LLM_SAMPLES=5
# Only used to generate ensemble diversity; ignored (forced to 0) when
# LLM_SAMPLES=1, since there is no vote for temperature to diversify.
LLM_TEMPERATURE=0.7
# Per model attempt.
LLM_TIMEOUT_SECONDS=8
# One batched call plus at most one repair round.
LLM_MAX_ATTEMPTS=2
# Hard ceiling; the judge harness times out at 30s.
REQUEST_DEADLINE_SECONDS=27
# Plausible-set mass target; calibrated at Gate 3.
HEDGE_ALPHA=0.10
# Cap on subset enumeration (2^5 = 32 LPs, ~32 ms).
HEDGE_MAX_CANDIDATES=5
# false -> degrades to the conventional single-interpretation path.
HEDGE_ENABLED=true

# --- service ------------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
