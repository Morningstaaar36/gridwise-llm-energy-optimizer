# Copy to .env and fill in. NEVER commit .env.  `.gitignore` already blocks it.
# Every provider below speaks the OpenAI chat-completions protocol, so there is
# exactly one adapter in app/interpretation/provider.py and zero provider-specific code.

# --- primary model (hosted; this is what the judge's traffic hits) -----------
# OpenAI      -> https://api.openai.com/v1
# Groq        -> https://api.groq.com/openai/v1
# Gemini      -> https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter  -> https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

# --- fallback model (Siyam's local Ollama, or a second hosted provider) ------
# Leave blank to disable. Must still be a language model: an empty fallback may
# NEVER be turned into "all notes are no_op".
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_API_KEY=ollama
LLM_FALLBACK_MODEL=qwen3:8b

# --- CLAMP knobs ------------------------------------------------------------
LLM_SAMPLES=5                 # K samples requested in ONE batched call. K=1 disables hedging.
LLM_TEMPERATURE=0.7           # only used to generate ensemble diversity
LLM_TIMEOUT_SECONDS=8         # per model attempt
LLM_MAX_ATTEMPTS=2            # batched call + at most one repair round
REQUEST_DEADLINE_SECONDS=27   # hard ceiling, judge times out at 30
HEDGE_ALPHA=0.10              # plausible-set mass target; calibrated at Gate 3
HEDGE_MAX_CANDIDATES=5        # cap on subset enumeration (2^5 = 32 LPs ~ 32 ms)
HEDGE_ENABLED=true            # false -> degrades to the conventional single-interpretation path

# --- service ----------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
